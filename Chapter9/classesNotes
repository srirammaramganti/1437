Access Modifiers:
public: -> allows changes directly
private: -> does not allow changes directly

ex: class Student {
    private:
        string name;
    public:
        void SetName(string name) {
            //this allows you to use the same variable
            //setting name = name from private or to private
            this->name = name;
        }
        string GetName() {
            //retreiving name from the private access modifier
            return name;
        }
};

