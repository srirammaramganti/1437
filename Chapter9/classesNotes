Member Functions: 
Mutators
mutators or setters - modify private data
class Weather {
    private:
        string condition;
        double temperature;
    public:
        void SetCondition(string condition) {
            this->condition = condition;
        }
        or
        void SetCondition(string cond) {
            condition = cond;
        }
        ------
        void SetTemperature(double temperature) {
            this-temperature = temperature;
        }
}
Accessors
accessors or getters - retreive private data
class Weather {
    private:
        string condition;
        double temperature;
    public:
        string GetTemperature() {
            //actively returning the private variable temperature in a public manner giving us a way to see the data
            return temperature;
        }
        double GetCondition() {
            //actively returning the private variable condition in a public manner giving us a way to see the data
            return condition;
        }
}

Using Classes in main:
class Weather {
    private:
        string condition;
        double temperature;
    public:
        void SetCondition(string condition) {
            this->condition = condition;
        }
        void SetTemperature(double temperature) {
            this-temperature = temperature;
        }
        string GetTemperature() {
            return temperature;
        }
        double GetCondition() {
            return condition;
        }
}

int main() {
    Weather w;
    w.SetCondition("Sunny");
    w.SetTemperature(67.69);
    //set assigns the values to the variable then the variable is return in get so that is why we are returning get
    cout << w.GetCondition() << " " << w.GetTemperature() << endl;
}

Function Overloading:
same function name, but different parameter - we are overloading the functions and the compiler will decide what to call

class Math {
    public:
    //the compiler will decide what to call based on the inputs provided
    // if the input is 2 int then it will pull the int Add or if the input is 2 doubles then it will pull the double Add
        int Add(int a, int b) {
            return a + b;
        }
        double Add(double a, double b) {
            return a + b;
        }
}

