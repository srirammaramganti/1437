{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build content tracker",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "main.cpp",
        "content.cpp",
        "movie.cpp",
        "tvShow.cpp",
        "-o",
        "${workspaceFolder}/content-tracker.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
